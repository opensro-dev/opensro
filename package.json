{
    "name": "sro-browser-rebuild",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.6.0",
    "engines": {
        "node": ">=22.15"
    },
    "scripts": {
        "dev": "pnpm --filter @sro/client-next dev",
        "preview": "pnpm --filter @sro/client-next preview",
        "build": "node scripts/task.mjs build",
        "test": "node scripts/task.mjs test",
        "check": "node scripts/task.mjs check",
        "assets": "node scripts/task.mjs assets",
        "release": "node scripts/task.mjs release",
        "task": "node scripts/task.mjs",
        "typecheck": "pnpm -r --filter=!sro-browser-rebuild typecheck",
        "hooks:install": "node scripts/setup_git_hooks.mjs"
    },
    "devDependencies": {
        "@babylonjs/core": "9.28.0",
        "@babylonjs/loaders": "9.28.0",
        "@dprint/typescript": "0.96.1",
        "@types/node": "^26.6.3",
        "dprint": "0.57.4",
        "esbuild": "^0.28.2",
        "fast-check": "4.10.2",
        "playwright-core": "^1.63.0",
        "typescript": "catalog:",
        "vite": "^8.3.1"
    }
}
