# ===========================================================================
# opensro-monitor-wtprobe.service - read the off-host WebTransport probe.
# wtprobe_host.py binds this template to one immutable control version. It
# reads the verdict the off-host runner pushes and pages like the fleet check;
# it cannot change release or database state (#1984).
# ===========================================================================
[Unit]
Description=Check the off-host OpenSRO WebTransport probe
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=opensro-monitor
Group=opensro-monitor
ExecStart=/usr/bin/python3 @RELEASE_MODULES@/monitor.py /etc/opensro-release/monitor-wtprobe.json
TimeoutStartSec=45
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/opensro-release/public/health
UMask=0022

[Install]
WantedBy=multi-user.target
