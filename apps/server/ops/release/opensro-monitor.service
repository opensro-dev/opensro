# ===========================================================================
# opensro-monitor.service - independently observe the public fleet.
# The installer binds this template to one immutable control version. It has no
# dependency on Agent or GameWorld and cannot change release or database state.
# ===========================================================================
[Unit]
Description=Check public OpenSRO availability
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=opensro-monitor
Group=opensro-monitor
ExecStart=/usr/bin/python3 @RELEASE_MODULES@/monitor.py /etc/opensro-release/monitor.json
TimeoutStartSec=45
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/opensro-release/public/health
UMask=0022

[Install]
WantedBy=multi-user.target
