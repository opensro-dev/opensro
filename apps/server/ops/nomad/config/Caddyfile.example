# ===========================================================================
# Caddyfile.example - HTTPS routing for a standalone OpenSRO edge.
# Nomad and all game listeners stay on loopback. Browser assets use the measured
# TCP transport policy; the game connection is a proxied WebSocket.
# ===========================================================================

{
	servers {
		protocols h1 h2
	}
}

opensro.online {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		route {
			@private_api path /api/development/* /api/debug/*
			respond @private_api 404
			uri strip_prefix /api
			reverse_proxy 127.0.0.1:8787
		}
	}

	handle /shards/global-official/transport/* {
		uri strip_prefix /shards/global-official
		reverse_proxy 127.0.0.1:8788
	}

	# The browser client. `sro-nomad publish-client` keeps the current release
	# at client and the one before it at previous (ops/nomad/LINUX_SINGLE_HOST.md).
	@client path /play /play/ /index.html /release.json /assets/* /favicon.ico
	handle @client {
		# Cache policy. Content-hashed names never change meaning: Vite bundles
		# (name-<8+ char hash>), packs (name-NNN-<12 hex>) and per-asset
		# transports (<64 hex>) are immutable for a year. Every other client
		# path - the page, release.json, the pack index - revalidates on each
		# use, which costs a 304 when unchanged, so a refresh or a new visit
		# always sees the current release.
		@immutable path_regexp ^/assets/(.+-[A-Za-z0-9_-]{8,}\.(js|css)|packs/(.+/)?[a-z0-9-]+-[0-9]{3}-[0-9a-f]{12}\.bin(\.zst)?|packs/transport/[0-9a-f]{64}\.gz)$
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@revalidate not path_regexp ^/assets/(.+-[A-Za-z0-9_-]{8,}\.(js|css)|packs/(.+/)?[a-z0-9-]+-[0-9]{3}-[0-9a-f]{12}\.bin(\.zst)?|packs/transport/[0-9a-f]{64}\.gz)$
		header @revalidate Cache-Control "no-cache"

		root * /var/www/opensro
		@play path /play /play/
		rewrite @play /index.html
		# The current release first. The previous release still serves the
		# hashed files that an open tab or a page loaded before the last
		# publish references, for one release generation.
		try_files /client{path} /previous{path}
		file_server {
			precompressed gzip
		}
	}

	handle {
		root * /var/www/opensro
		# Releases are reachable only through the client routes above.
		@releases path /releases/* /client/* /previous/*
		respond @releases 404
		file_server
	}
}

www.opensro.online {
	redir https://opensro.online{uri} permanent
}
