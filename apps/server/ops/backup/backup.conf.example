# ===========================================================================
#
# backup.conf - opensro-backup settings (install as /etc/opensro-backup/backup.conf)
#
# Secrets are separate root-only files in the same directory:
#   restic-password   generated by install.sh; keep a copy OFF the server
#   rclone.conf       the Google Drive remote (see README.md, "Setup")
#   discord-webhook   staff-channel webhook URL for alerts (optional)
#
# ===========================================================================

# The game server's state directory (databases, cluster secrets).
STATE_ROOT=/opt/opensro/apps/server/.state

# rclone remote and folder holding the restic repository.
RCLONE_REMOTE=gdrive:opensro-backups

# Retention: nightly snapshots kept per period.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Host configuration copied as-is (globs allowed). Certificates under
# /var/lib/caddy can be re-issued, but restoring them avoids rate limits.
EXTRA_PATHS="/etc/caddy /etc/nomad.d /etc/systemd/system/opensro* /etc/systemd/system/nomad.service /etc/opensro-web /var/lib/caddy/.local/share/caddy"

# PostgreSQL databases dumped with pg_dump when present.
POSTGRES_DATABASES="opensro_web"
