# ===========================================================================
# opensro-backup.timer - nightly at 05:00 UTC, the measured attach trough
# ===========================================================================
[Unit]
Description=OpenSRO nightly backup

[Timer]
OnCalendar=*-*-* 05:00:00 UTC
RandomizedDelaySec=15min
# A run missed while the host was down happens at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
