# local.env - the development settings `pnpm local` runs with.
#
# scripts/local/run.mjs reads this file before it starts anything.
# LOCAL_* lines steer the runner itself. Every other KEY=VALUE line is
# passed to the Agent and GameWorld processes as environment, so shard
# rules (the SRO_* switches) can be set here for local play; unset rules
# keep their native defaults. Lines starting with # are comments.

# The shard to run: an enabled id from shards.json in this folder. The
# GameWorld's player transport and control addresses come from that
# shard's transportUrl and controlUrl there.
LOCAL_SHARD_ID=global-official

# Where the Agent API listens; the client proxy and the GameWorld call
# it here.
LOCAL_AGENT_ADDR=127.0.0.1:8787

# Both processes' log level: debug, info, warn or error.
LOG_LEVEL=info

# Examples (uncomment to set a shard rule locally):
# SRO_MOST_WANTED=on
# SRO_JOB_SUIT_TIERS=on
# A finished job dress reloads at the nearest town spawn (port-only):
# SRO_JOB_DRESS_TOWN_SPAWN=on
# No resurrection / reverse return scroll in a job suit (port-only, live):
# SRO_JOB_BLOCK_RESURRECTION_SCROLL=1
# SRO_JOB_BLOCK_REVERSE_RETURN_SCROLL=1
