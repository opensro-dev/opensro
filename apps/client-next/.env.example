# Copy the lines you need into .env.local (untracked), or set them in the
# environment, then restart the client server. See docs/HOSTING.md.

# Development/preview edge (server-side; never bundled into browser code).
# Agent behind /api:
# SRO_AGENT_PROXY_TARGET=http://127.0.0.1:8787
# Shard catalog whose publicTransportUrl routes this edge serves:
# SRO_SHARD_CATALOG=../server/config/shards.json

# Public host names a TLS-terminating tunnel (Cloudflare Tunnel, ngrok) serves
# this edge on, comma-separated, without scheme or port:
# SRO_DEV_TUNNEL_HOSTS=play.example.com

# pnpm dev:https only. Without a pair, a self-signed certificate is generated.
# Use mkcert (or any CA your devices trust) for warning-free LAN/mobile access:
# SRO_DEV_TLS_CERT=.certs/dev.pem
# SRO_DEV_TLS_KEY=.certs/dev-key.pem

# Browser API base, embedded at build time. Keep same-origin /api unless the
# Agent has its own public origin.
# VITE_AGENT_API_BASE=/api
