# deploy.example.env - the deploy settings, as an example.
# Copy it to deploy/deploy.env (ignored by git) and fill in your values:
#   cp deploy/deploy.example.env deploy/deploy.env
# The environment wins over deploy.env. Keep comments on their own lines.

# The Docker host, as ssh reaches it.
DEPLOY_HOST=user@your-docker-host

# The stack's folder on that host, relative to the ssh user's home.
DEPLOY_PATH=silkroad

# The private registry repository: <repo>:server-<tag>, identity-<tag>, web-<tag>.
IMAGE_REPO=ghcr.io/<github-user>/silkroad

# Unset, each tag holds linux/amd64 and linux/arm64.
# PLATFORM=linux/arm64
