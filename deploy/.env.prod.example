# .env.prod - the stack's settings on the server (~/silkroad/.env.prod).
# Copy this file, then keep it on the server only: it is never versioned.

# The public host Traefik routes to the web container.
SRO_DOMAIN=sro.diorg.es

# The existing Traefik's entrypoint and certificate resolver (the IdleAge host's names).
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=mytlschallenge

# debug, info, warn or error.
LOG_LEVEL=info

# Shard rules (SRO_* switches) do not go here: put them in shard.env beside this file, one
# KEY=VALUE per line. Unset rules keep their native defaults.
