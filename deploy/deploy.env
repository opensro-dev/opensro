# deploy.env - the deploy settings, versioned. No secrets here.
# To change one on your machine only, put KEY=value in deploy/local.env
# (not versioned). The environment wins over both. Keep comments on their
# own lines.

# The Docker host (user@host) is not versioned: put DEPLOY_HOST=... in
# deploy/local.env. The stack folder there, relative to that user's home:
DEPLOY_PATH=silkroad

# The private registry repository: <repo>:server-<tag>, identity-<tag>, web-<tag>.
IMAGE_REPO=ghcr.io/<github-user>/silkroad

# Unset, each tag holds linux/amd64 and linux/arm64.
# PLATFORM=linux/arm64
