# shard-pvp.env.example - the PVP shard's own rules (port-only, not native).
# Copy it to shard-pvp.env beside docker-compose.prod.yml on the host.
# The PVP GameWorld reads shard.env first, then this file: the content
# switches (SRO_ALEXANDRIA, SRO_CAP110_*, ...) come from shard.env, and
# what is set here wins.

# Characters are created finished, in Samarkand; Samarkand's merchants
# sell degree-11 rare gear +12 and degree-11 stones at one gold.
SRO_PVP_SERVER=on

# The level characters are created at.
SRO_LEVEL_CAP=110

# Lifts the total mastery allowance so every mastery fits at the cap.
SRO_BETA_MASTERY=on
